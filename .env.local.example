# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Supabase project URL (found in: Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose in the browser — RLS is the guard)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase service role key — NEVER expose to the browser.
# Only needed for server-side admin operations (e.g., seeding, migrations).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
